# PostgreSQL connection string. On Railway, add a PostgreSQL plugin and it will
# automatically inject DATABASE_URL into this service's environment.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coffee_pms

# Used to sign session cookies. Set a long random value in production.
SECRET_KEY=please-change-this-to-a-random-secret

# Password for the auto-seeded "admin" user, created only if no users exist yet.
# Set this to something secure before first deploy — the built-in default (admin123)
# is fine for local development only.
ADMIN_SEED_PASSWORD=admin123

# development | production — production enables secure (HTTPS-only) session cookies
# and warns if SECRET_KEY is still the default.
ENV=development
